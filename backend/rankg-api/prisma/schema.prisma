generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Feedback {
  id        String   @id @default(uuid())
  gameId    Int
  userName  String
  comment   String
  rating    Int // Nota de 1 a 5
  createdAt DateTime @default(now())

  @@index([gameId])
}
